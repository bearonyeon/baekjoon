import java.util.Scanner;

public class Main {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		int n = sc.nextInt();
		int[] scores = new int[n];
		int max = 0;
		
		for (int i = 0; i < n; i++) {
			scores[i] = sc.nextInt();
			if (scores[i] > max) {
				max = scores[i];
			}
		}
		
		double[] newScores = new double[n];
		double total = 0.0d;
		double avg;
		
		for (int i = 0; i < n; i++) {
			newScores[i] = (double)scores[i] / max * 100;
			total += newScores[i];
		}
		avg = (double)total / n;
		
		System.out.println(avg);
		
		sc.close();
	}

}
