import java.util.Scanner;

public class Main {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		int n = sc.nextInt();
		int m = sc.nextInt();
		int[] arr = new int[n];
		
		for (int a = 0; a < n; a++) {
			arr[a] = a + 1;
		}
		
		for (int a = 0; a < m; a++) {
			int i = sc.nextInt() - 1;
			int j = sc.nextInt() - 1;
			
			for (int b = 0; b <= (j - i) / 2; b++) {
				int temp = arr[i + b];
				arr[i + b] = arr[j - b];
				arr[j - b] = temp;
			}
		}
		
		for (int c = 0; c < arr.length; c++) {
			System.out.print(arr[c] + " ");
		}
	
		sc.close();
	}

}
