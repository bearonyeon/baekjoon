import java.util.Scanner;

public class Main {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		int n = sc.nextInt();
		int total = 0;
		
		String num = sc.next();
			
		for (int j = 0; j < n; j++) {
			total += num.charAt(j) - '0';
		}
	
		System.out.println(total);
		
		sc.close();
	}

}
